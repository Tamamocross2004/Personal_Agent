{
  "name": "personal-agent-desktop",
  "productName": "Personal Agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "dev": "vite --host 127.0.0.1",
    "smoke": "node scripts/smoke.cjs",
    "smoke:acceptance": "node scripts/acceptance-smoke.cjs",
    "smoke:lifecycle": "node scripts/acceptance-smoke.cjs --lifecycle-only",
    "format": "prettier --write src electron scripts package.json tsconfig.json index.html",
    "smoke:folders": "node scripts/folder-workflow-smoke.cjs --index --questions --export"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^44.9.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "undici": "^8.12.2",
    "vite": "^7.0.0"
  }
}
