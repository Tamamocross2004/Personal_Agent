# 复制本文件为 .env 并填入你自己的 Key：  cp .env.example .env

# 当前使用的厂商：deepseek | qwen | glm | kimi | custom
LLM_PROVIDER=deepseek

# 可选：覆盖该厂商的默认模型名 / 接口地址（模型更新很快，以官方文档为准）
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com

# 各厂商 API Key（只需填你要用的那个）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
# provider=custom 时使用（任意 OpenAI 兼容服务，如本地 vLLM / Ollama）
CUSTOM_API_KEY=

# 调用参数
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
# 单次回复最大输出 token（可选，不填用厂商默认值）
# LLM_MAX_TOKENS=8192

# ---- Agent 运行保护 ----
AGENT_MAX_STEPS=30
# 单个研究任务的"等效 token"上限；用到 80% 时提醒模型收尾，预计下一次调用会超出时强制收尾
# 等效 token = 未命中缓存的输入 × 1 + 命中缓存的输入 × TOKEN_WEIGHT_CACHED + 输出 × TOKEN_WEIGHT_OUTPUT
# 默认权重比 DeepSeek 实际价格比例（约 0.02 : 1 : 4）保守，换厂商时不易低估花费
AGENT_TOKEN_BUDGET=300000
TOKEN_WEIGHT_CACHED=0.1
TOKEN_WEIGHT_OUTPUT=2.0
# 单次工具执行超时（秒）
TOOL_TIMEOUT=60
# Python 子进程超时（秒）；实际执行时限不超过 TOOL_TIMEOUT 的 80%，预留清理时间
CODE_EXEC_TIMEOUT=30

# ---- 阶段 7：报告审稿（独立上下文调用，计入任务 token 预算） ----
REPORT_REVIEW_ENABLED=true
# 每个研究任务最多审稿两次（初稿与修订稿）；超过上限明确记为未审稿
REPORT_REVIEW_MAX_CALLS=2
REPORT_REVIEW_MAX_TOKENS=2048

# ---- 上下文管理 ----
# 上下文估算超过该 token 数时，把旧的网页原文 / 搜索摘要移出上下文（0 = 关闭）
# 有前缀缓存的厂商（DeepSeek 等）上压缩不省钱、反而让缓存失效，所以默认设得较高，只防止上下文过大；
# 没有自动缓存的厂商可以调低。用 python -m agent.simulate <任务目录> 离线评估不同阈值
CONTEXT_COMPACT_THRESHOLD=60000
# 最近几轮的工具结果不压缩
CONTEXT_KEEP_RECENT_TURNS=2

# ---- 读网页备用通道 ----
# 直接下载失败时改用 Jina Reader（https://r.jina.ai）读取：jina | none
# 注意：启用后，读取失败的网页 URL 会发送给第三方服务 Jina
FETCH_FALLBACK=jina
# 可选：Jina API Key，不填为匿名访问（有频率限制）
JINA_API_KEY=
