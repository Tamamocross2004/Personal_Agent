# 复制本文件为 .env 并填入你自己的 Key：  cp .env.example .env

# 当前使用的厂商：deepseek | qwen | glm | kimi | custom
LLM_PROVIDER=deepseek

# 可选：覆盖该厂商的默认模型名 / 接口地址（模型更新很快，以官方文档为准）
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com

# 各厂商 API Key（只需填你要用的那个）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
# provider=custom 时使用（任意 OpenAI 兼容服务，如本地 vLLM / Ollama）
CUSTOM_API_KEY=

# 调用参数
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
